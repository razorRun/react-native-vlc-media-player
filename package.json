{
  "name": "react-native-vlc-media-player",
  "version": "1.0.103",
  "description": "React native media player for video streaming and playing. Supports RTSP,RTMP and other protocols supported by VLC player",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "app.plugin.js",
    "react-native-vlc-media-player.podspec",
    "expo",
    "android/src",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "ios",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/.*"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "del-cli lib",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run lint && npm run typecheck && npm run check-spec && npm run check-babel",
    "example": "npm run --workspace react-native-vlc-media-player-example",
    "prepare": "bob build",
    "check-spec": "node scripts/check-codegen-spec.js",
    "check-babel": "node scripts/check-babel-codegen.js"
  },
  "keywords": [
    "vlc",
    "player",
    "android",
    "ios",
    "react-native",
    "mp4",
    "rtsp",
    "media",
    "video"
  ],
  "author": "rmilinda@gmail.com",
  "vlc": {
    "ios": "3.5.1",
    "android": "3.6.3"
  },
  "dependencies": {
    "react-native-vector-icons": "^9.2.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@expo/config-plugins": "^7.2.2",
    "@react-native/babel-plugin-codegen": "0.81.5",
    "@types/react": "^19.1.17",
    "@types/react-native-vector-icons": "^6.4.18",
    "del-cli": "^7.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razorRun/react-native-vlc-media-player.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/razorRun/react-native-vlc-media-player/issues"
  },
  "homepage": "https://github.com/razorRun/react-native-vlc-media-player#readme",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "ReactNativeVlcMediaPlayerSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.yuanzhou.vlc.vlcplayer"
    },
    "ios": {
      "components": {
        "VlcPlayerView": {
          "className": "VlcPlayerComponentView"
        }
      }
    }
  }
}
